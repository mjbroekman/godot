; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Local Multiplayer Fighter"
run/main_scene="res://Scenes/Screens/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*res://Scripts/Global.gd"
MultiplayerInput="*res://addons/multiplayer_input/multiplayer_input.gd"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Local Multiplayer Fighter"

[editor_plugins]

enabled=PackedStringArray("res://addons/multiplayer_input/plugin.cfg")

[global_group]

Player=""
TileMap=""
Projectile=""

